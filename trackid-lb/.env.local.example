# WhatsApp Cloud API — Phase 3 (staff alert) + ROADMAP Part 7 (customer status updates)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=                    # team's WhatsApp number (international format, e.g. +9611234567)
WHATSAPP_ORDER_ALERT_TEMPLATE_NAME=           # approved template for the staff new-order alert — see ENV_VARS.md; unset = feature off
WHATSAPP_ORDER_ALERT_TEMPLATE_LANG=en
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE_NAME=    # approved template for the customer order-confirmation — see ENV_VARS.md; unset = feature off
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE_LANG=en
WHATSAPP_STATUS_TEMPLATE_NAME=                # approved template for customer status updates — see ENV_VARS.md; unset = feature off
WHATSAPP_STATUS_TEMPLATE_LANG=en

# Payments (ROADMAP F1/F2) — three layers, all must line up before a customer
# ever sees "Card" or "OMT" at checkout:
#   1. This env var (deploy-time master switch — off in production unless set)
#   2. The matching Site Settings → Commerce checkbox (cardPaymentsEnabled / omtPaymentEnabled)
#   3. For card specifically, a real usable provider (only "Mock" exists so far)
# Deliberately redundant with #2 — a mis-set admin toggle alone can never turn
# on a payment method that isn't actually ready (Areeba/OMT/Whish confirmations).
# Always on in development so local testing needs no extra setup.
# ONLINE_PAYMENTS_ENABLED=true   # required in production for Card OR OMT to ever appear/process, regardless of Site Settings
# ALLOW_MOCK_PAYMENTS=true       # ALSO required (on top of the above) to test the mock card provider once NODE_ENV=production (e.g. a preview deploy); always on in dev
# MOCK_PAYMENT_SECRET=some-long-random-string   # signs the mock webhook payload; defaults to a dev-only value if unset
# PAYMENT_RESERVATION_MINUTES=45 # how long stock stays reserved on an unpaid card order before the expiry cron releases it
# OMT_RESERVATION_HOURS=48       # same, for OMT vouchers — a branch visit takes much longer than a card session

# App
SITE_URL=http://localhost:3000

# Schema mode — dev auto-pushes schema changes (fast iteration) UNLESS this is
# set, which opts a dev run into migration-only mode instead (matches prod).
# Drizzle push applies destructive diffs with no data-preservation step; point
# dev at a DISPOSABLE database (see MIGRATIONS.md) so a push never touches
# anything you care about. Production ignores this — it's always migration-only.
# PAYLOAD_MIGRATE=true

# Seed script (optional) — `npm run seed` POSTs to /api/seed while the app runs.
# Freely allowed in development; in production the route refuses unless SEED_SECRET
# is set here (and on the deployment) and passed by the script.
# SEED_SECRET=some-long-random-string
# SEED_URL=http://localhost:3000   # override the target base URL if not localhost:3000

# Cron auth (production only) — protects /api/cron/* routes (the daily
# abandoned-guest-cart cleanup and the online-payment expiry sweep, see
# vercel.json). When set, Vercel automatically
# signs its own Cron Job invocations with this value as a Bearer token — you
# only need to set it in Vercel's env, generate any long random string.
# CRON_SECRET=some-other-long-random-string

# Error monitoring (optional) — fully off with no DSN set (zero build/runtime
# behavior change). Create a free Sentry project (sentry.io) for a Next.js app,
# grab the DSN from Project Settings → Client Keys.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXXX.ingest.us.sentry.io/XXXXX
# Optional, only needed for source-map upload (readable stack traces in Sentry —
# without these, error tracking still works, traces are just minified):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=from Sentry → Settings → Auth Tokens (needs project:releases scope)

# White-label (optional) — defaults to "trackID.lb" if unset. Can't come from
# the CMS because the admin panel's title loads before the database is reachable.
# NEXT_PUBLIC_STORE_NAME=trackID.lb   # admin browser-tab title suffix
