# Copy this file to .env.local and fill in the values

# Payload CMS
PAYLOAD_SECRET=change-this-to-a-long-random-string

# PostgreSQL — use the Supabase "pooler" connection string (port 6543)
DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Storage (replaces Cloudinary — unavailable in Lebanon)
# Same project as DATABASE_URI — just the project ref and public bucket name
NEXT_PUBLIC_SUPABASE_URL=https://bdbhygelwizizepxewxv.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=products
# Supabase Storage S3-compatible connection (Project Settings → Storage → S3 Connection)
SUPABASE_S3_ENDPOINT=https://bdbhygelwizizepxewxv.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-central-1
ACCESS_KEY_ID_SUPABASE=f4e5e9b90f91ac3dffc662e3ab033413
SECRET_ACCESS_KEY_SUPABASE=cc221b01f3437f9963178f6febada44a4aa9d35bd9f24773ed5f7e53b8be16f5

# Resend (email) — Phase 3
RESEND_API_KEY=re_YgLzY179_PDxqHmsLUpXxb3qY62uCQEgD
# Use onboarding@resend.dev for testing (sends only to your Resend account email)
# Switch to orders@trackid.lb once domain is verified in Resend dashboard
RESEND_FROM=onboarding@resend.dev

# WhatsApp Cloud API — Phase 3
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=   # team's WhatsApp number (international format, e.g. +9611234567)

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Schema push (DANGEROUS while dev + prod share one database) — dev never pushes
# schema changes unless this is explicitly set. Drizzle push applies destructive
# diffs with no data-preservation step; prefer migrations (see MIGRATIONS.md).
# PAYLOAD_PUSH=true

# Seed script (optional) — `npm run seed` POSTs to /api/seed while the app runs.
# Freely allowed in development; in production the route refuses unless SEED_SECRET
# is set here (and on the deployment) and passed by the script.
# SEED_SECRET=some-long-random-string
# SEED_URL=http://localhost:3000   # override the target base URL if not localhost:3000

# White-label (optional) — both default to the trackID.lb values if unset.
# These two can't come from the CMS: the cart key is read client-side before any
# DB call, and the admin title loads before the database. Set them when rebranding.
# NEXT_PUBLIC_STORE_NAME=trackID.lb   # admin browser-tab title suffix
# NEXT_PUBLIC_CART_KEY=trackid-cart   # localStorage namespace for the cart
